import { Button, VerticalBox } from "std-widgets.slint";
export component RetryOpenScreen inherits VerticalBox {
    callback retry;
    callback quit;
    
    Text {
        text: "Failed to auto detect camera";
    }

    Button {
        text: "Retry";
        clicked => root.retry();
    }
    Button {
        text: "Quit";
        clicked => root.quit();
    }
}
